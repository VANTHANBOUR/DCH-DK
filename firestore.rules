rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == "vanthanbour@diu.edu.kh");
      allow update: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == "vanthanbour@diu.edu.kh");
      allow delete: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == "vanthanbour@diu.edu.kh");
    }

    // Lesson Plans
    match /lessonPlans/{planId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Classrooms
    match /classrooms/{classId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
